aws_region   = "eu-west-1"
project_name = "container-web"
environment  = "dev"

# Replace this placeholder with the digest-pinned image URI published through the manual workflow.
app_image_uri = "000000000000.dkr.ecr.eu-west-1.amazonaws.com/example-app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
app_port      = 3000

# Seeds the ECS service at creation time. Application Auto Scaling manages
# runtime desired count afterward, and Terraform ignores desired_count drift.
service_desired_count = 1
service_min_capacity  = 1
service_max_capacity  = 3

# Optional: provide existing SNS topic ARNs to receive alarm and recovery notifications.
alarm_action_arns = []
ok_action_arns    = []

# Optional: create a GitHub OIDC role for the manual ECR image release workflow.
# The GitHub OIDC provider is an account-level prerequisite and is not created by this stack.
enable_github_ecr_release_role = false
github_oidc_provider_arn       = ""
github_repository              = "hongzz0618/aws-containerized-web-app"
github_release_environment     = "container-release"
